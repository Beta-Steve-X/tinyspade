entity design(clk: clock, rst: bool, ui_in: [bool; 8]) -> uint<8> {
    let (vsync, hsync, display_on, hpos, vpos) = inst vga::hvsync_gen(clk, rst);

    reg(unsafe{(!hsync).as_clock()}) dy2: uint<20> = ((vpos.to_int() - 240) * (vpos.to_int() - 240)).abs().trunc();
    // reg(clk) dx2: uint<20> = ((hpos.to_int() - (320 + if(hpos > 320) {-152} else {152})) * (hpos.to_int() - (320 + if(hpos > 320) {-152} else {152}))).abs().trunc();
    // reg(clk) dx2: uint<20> reset(!display_on: (320u9 + 152u9) * (320u9 + 152u9)) = dx2 -. ((if(hpos <= 320) {320u10 +. 152u10} else {320u10 -. 152u10}) * 2u10 -. 2 -. hpos * 2u10);
    // reg(clk) dx2_2: uint<20> reset(!display_on: (320u9 - 152u9) * (320u9 - 152u9)) = dx2_2 -. ((320u10 -. 152u10) * 2u10 -. 0 -. hpos * 2u10);
    // reg(clk) dx21: uint<20> reset(!display_on: (320u9 - 56u9) * (320u9 - 56u9)) = dx21 -. ((if(hpos <= 320) {320u10 -. 56u10} else {320u10 +. 56u10}) * 2u10 -. 2 -. hpos * 2u10);
    // reg(clk) dx22: uint<20> reset(!display_on: (320u9 - 94u9) * (320u9 - 94u9)) = dx22 -. ((if(hpos <= 320) {320u10 -. 94u10} else {320u10 +. 94u10}) * 2u10 -. 2 -. hpos * 2u10);
    reg(clk) dx31: uint<20> reset(!display_on: (320u9 - 45u9) * (320u9 - 45u9)) = dx31 -. ((if(hpos <= 320) {320u10 -. 45u10} else {320u10 +. 45u10}) * 2u10 -. 2 -. hpos * 2u10);

    let inside = inst sqrcntr(clk, display_on, hpos, 320, -152) + dy2 < 25680;
    let inside1 = inst sqrcntr(clk, display_on, hpos, 320, 56) + dy2 < 2220  && !(inst sqrcntr(clk, display_on, hpos, 320, 110) + dy2 < 8000);
    let inside2 = inst sqrcntr(clk, display_on, hpos, 320, 46) + dy2 < 600 && !(inst sqrcntr(clk, display_on, hpos, 320, 64) + dy2 < 1000);

    let R: [bool; 2] = if(display_on) {[inside, inside]} else {[false; 2]};
    let G: [bool; 2] = if(display_on) {[inside1, inside1]} else {[false; 2]};
    let B: [bool; 2] = if(display_on) {[inside2, inside2]} else {[false; 2]};

    // TinyVGA PMOD
    [hsync, B[0], G[0], R[0], vsync, B[1], G[1], R[1]].reversed().to_uint()
}

entity sqrcntr(clk: clock, display_on: bool, hpos: uint<10>, mirrorx: uint<10>, xoff: int<11>) -> uint<20> {
    reg(clk) dx: uint<20>
        reset(!display_on: ((mirrorx.to_int() -. xoff) * (mirrorx.to_int() -. xoff)).abs().trunc())
        = dx -. ((if(hpos < mirrorx) {mirrorx.to_int() -. xoff} else {mirrorx.to_int() +. xoff}).abs().trunc() * 2u10 -. if(hpos < mirrorx) {2} else {0} -. hpos * 2u10);
    dx
}

fn clogo(x: uint<10>, dy2: uint<20>, lx: uint<10>, dx20: uint<20>) -> bool {
    let dx: int<11> = (x.to_int() -. lx.to_int()).abs().to_int().trunc(); // Signed distance x <-> lx

    let mid: bool = dx20 +. dy2 <= 25680;

    let med: bool = (sqr((dx - 56).abs().trunc()) +. dy2 <= 1920) && (sqr((dx - 94).abs().trunc()) +. dy2 > 5060);

    let out: bool = (sqr((dx - 45).abs().trunc()) +. dy2 <= 289) && (sqr((dx - 62).abs().trunc()) +. dy2 > 582);

    mid || med || out
}

fn logo(x: uint<10>, y: uint<10>, lx: uint<10>, ly: uint<10>) -> bool {
    let dx = (x.to_int() - lx.to_int()).abs();
    let dy = (y.to_int() - ly.to_int()).abs();
    dx <= 45 && dy < 50 && ologo(trunc(dx), trunc(dy))
}

fn ologo(x: uint<6>, y: uint<6>) -> bool {
    // let mid: bool = 6u3 * x + zext(y) < 50;
    let mid: bool = (50u6 * x).max(8u6 * y) + ((50u6 * x).min(8u6 * y) >> 1) < 400;
    // let med: bool = (x - (y >> 2) -. 18u7) * 14u4 + y * 2 < 76;
    let med: bool = zext(y) <= 3u3 * x - 37 && zext(y) <= x + 4 && (zext(y) >= 6u3 * x - 137 || zext(y) >= 2u3 * x - 29 || (x <= 23 && x > 13));
    // let out: bool = (x - (y >> 1) -. 33u7) * 14u4 + y * 4 < 70;
    let out: bool = zext(y) <= 2u2 * x - 58 && zext(y) <= x / 2 - 4 && (zext(y) > 3u2 * x - 113 || (x > 30 && x <= 38));

    mid || med || out
}

fn len2(x: uint<10>, y: uint<10>) -> uint<20> {
    x * x +. y * y
}

fn sqr(x: uint<10>) -> uint<20> {
    x * x
}

entity seqsqr(clk: clock, rst: bool, x: uint<10>) -> uint<20> {
    // let x = x >> 1;
    reg(clk) sumctr: uint<4> reset(rst: 9) = if(sumctr == 0) {0} else {sumctr -. 1};
    let m: uint<11> = x * trunc(x >> zext(sumctr));
    reg(clk) sum: uint<20> reset(rst: 0) = sum +. zext(m << zext(sumctr));
    sum
}

// Compute |(x,y)| using CORDIC
fn len<#uint N, #uint PREC = 1, #uint EXT = 2>(x: int<N>, y: int<N>) -> uint<10> {
    let x: int<{N+PREC+EXT}> = sext(x) << PREC;
    let y: int<{N+PREC+EXT}> = sext(y) << PREC;

    let (x, y) = cordic::<0, _>(x, y);
    let (x, y) = cordic::<1, _>(x, y);
    let (x, y) = cordic::<2, _>(x, y);
    // let (x, y) = cordic::<3, _>(x, y);
    // let (x, y) = cordic::<4, _>(x, y);
    // let (x, y) = cordic(x, y, 5);
    // let (x, y) = cordic(x, y, 6);
    // let (x, y) = cordic(x, y, 7);

    trunc((x >> PREC).abs())
}

fn cordic<#uint i, #uint N>(x: int<N>, y: int<N>) -> (int<N>, int<N>) {
    if(y > 0) {
        (x +. (y >>> i), -(x >>> i) +. y)
    } else {
        (x -. (y >>> i), (x >>> i) +. y)
    }
}

/// This is the top module (main function) of TinyTapeout, before submission,
/// rename it to tt_um_<your username> or something else unique. Make sure to
/// also update the info.yaml top_module field
/// 
/// Depending on if your inputs are individual bits or binary numbers, you may want to change
/// between `[bool; 8]` and `uint<8>` for the ui/o signals.
/// 
/// Other than that, you most likely don't want to change this module at all, make any changes
/// you may want to do to `top` instead
#[no_mangle(all)]
entity tt_um_example(
    clk: clock,
    rst_n: bool,
    ui_in: [bool; 8],
    uo_out: inv& uint<8>,
    uio_in: uint<8>,
    uio_out: inv& [bool; 8],
    uio_oe: inv& [bool; 8],
    ena: bool,
) {
    // Spade uses active high reset, so we'll invert the tt reset
    let rst = !rst_n;
    // If you want to use the bidirectional IO, you'll want to change these
    set uio_out = &[false; 8];
    set uio_oe = &[false; 8];


    // Put your code to generate the output here
    let output = inst design(clk, rst, ui_in);

    set uo_out = &output;
}
