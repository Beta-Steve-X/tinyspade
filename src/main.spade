mod vga;

// entity design(clk: clock, rst: bool, ui_in: [bool; 8]) -> uint<8> {
//     let (_5, _6, _7, _8, _9) = inst hsync_gen::vga_gen(clk, rst);

//     if(/*_0 && _1 && */_5 && _6) {/*trunc(_3) ^ */trunc(_9)} else {trunc(_8/* + _4*/)}
// }

entity design(clk: clock, rst: bool, ui_in: [bool; 8]) -> uint<8> {
    let (vsync, hsync, display_on, hpos, vpos) = inst vga::hvsync_gen(clk, rst);

    reg(clk) counter: uint<10> reset(rst: 0) = counter +. 1;
    
    let moving_x: uint<10> = hpos +. counter;

    let inside: bool = logo(hpos, vpos, 320, 240);

    let R: [bool; 2] = if(display_on) {[inside, inside]} else {[false; 2]};
    let G: [bool; 2] = if(display_on) {[inside, inside]} else {[false; 2]};
    let B: [bool; 2] = if(display_on) {[inside, inside]} else {[false; 2]};

    // TinyVGA PMOD
    [hsync, B[0], G[0], R[0], vsync, B[1], G[1], R[1]].reversed().to_uint()
    // [hsync, false, false, false, vsync, false, vpos > 240 && display_on, hpos > 320 && display_on].reversed().to_uint()
}

fn logo(x: uint<10>, y: uint<10>, lx: uint<10>, ly: uint<10>) -> bool {
    let dx: uint<10> = (x.to_int() - lx.to_int()).abs().trunc(); // Distance x <-> lx
    let x2: uint<20> = dx*dx;
    let dy: uint<10> = (y.to_int() - ly.to_int()).abs().trunc(); // Distance y <-> ly
    let y2: uint<20> = dy*dy;

    let mid: bool = (x2 +. 152u10*152u10 +. 2u2*152u8*dx) +. y2 <= 25680;

    let med: bool = ((x2 +. 56u10*56u10 -. 2u2*56u8*dx) +. y2 <= 1920) && ((x2 +. 94u10*94u10 -. 2u2*94u8*dx) +. y2 > 5060);

    let out: bool = ((x2 +. 45u10*45u10 -. 2u2*45u8*dx) +. y2 <= 289) && ((x2 +. 62u10*62u10 -. 2u2*62u8*dx) +. y2 > 582);

    mid || med || out
}

/// This is the top module (main function) of TinyTapeout, before submission,
/// rename it to tt_um_<your username> or something else unique. Make sure to
/// also update the info.yaml top_module field
/// 
/// Depending on if your inputs are individual bits or binary numbers, you may want to change
/// between `[bool; 8]` and `uint<8>` for the ui/o signals.
/// 
/// Other than that, you most likely don't want to change this module at all, make any changes
/// you may want to do to `top` instead
#[no_mangle(all)]
entity tt_um_example(
    clk: clock,
    rst_n: bool,
    ui_in: [bool; 8],
    uo_out: inv& uint<8>,
    uio_in: uint<8>,
    uio_out: inv& [bool; 8],
    uio_oe: inv& [bool; 8],
    ena: bool,
) {
    // Spade uses active high reset, so we'll invert the tt reset
    let rst = !rst_n;
    // If you want to use the bidirectional IO, you'll want to change these
    set uio_out = &[false; 8];
    set uio_oe = &[false; 8];


    // Put your code to generate the output here
    let output = inst design(clk, rst, ui_in);

    set uo_out = &output;
}
